@PACKAGE_INIT@

# Static libdirtoo-filter still lists SQLite on its link interface; pull it in for dependents.
include(CMakeFindDependencyMacro)
find_dependency(SQLite3 REQUIRED)
find_dependency(dirtoo-hash REQUIRED)
find_dependency(dirtoo-tags REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/dirtoo-filterTargets.cmake")
check_required_components(dirtoo-filter)
